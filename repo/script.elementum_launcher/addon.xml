<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.elementum_launcher"
       name="Elementum Launcher (script)"
       version="1.0.0"
       provider-name="fontsvr">

  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>

  <!-- Extension per script (punt correcte) -->
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
  <summary lang="en">magnet via Elementum</summary>
  <description lang="en">Receives and executes PlayMedia(plugin://...)</description>
  <platform>all</platform>
  </extension>
</addon>
